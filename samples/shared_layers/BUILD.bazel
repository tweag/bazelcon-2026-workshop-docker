load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_tar")
load("@rules_img_images.bzl", "image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary")
load("//tools/platforms:defs.bzl", "LINUX")

# Two real-ish services — an `api` and a `worker` — that share layers.
# Both sit on the same python_base_img and include the same shared config +
# library layer; only the per-service app layer differs. Because layers are
# content-addressed, the base + common blobs are byte-identical across both
# images — built once, cached once, pushed once.
package(default_visibility = ["//visibility:public"])

exports_files([
    "common/settings.yaml",
    "common/shared.py",
])

# The deck transcludes `<<< ../samples/shared_layers/BUILD.bazel#shared`; copy it
# into bazel-bin for the hermetic //slides:build (rules_js runs from bazel-bin).
copy_to_bin(
    name = "slides_inputs",
    srcs = ["BUILD.bazel"],
)

# Shared config + library — identical in both images → one content-addressed blob.
pkg_tar(
    name = "common_layer",
    srcs = [
        "common/settings.yaml",
        "common/shared.py",
    ],
    package_dir = "/opt/app/common",
    strip_prefix = "common",
)

# Per-service app layers — the only thing that differs between the two images.
pkg_tar(
    name = "api_layer",
    srcs = ["api/main.py"],
    package_dir = "/opt/app",
    strip_prefix = "api",
)

pkg_tar(
    name = "worker_layer",
    srcs = ["worker/main.py"],
    package_dir = "/opt/app",
    strip_prefix = "worker",
)

layer_from_tar(name = "common_layer_img", src = ":common_layer")

layer_from_tar(name = "api_layer_img", src = ":api_layer")

layer_from_tar(name = "worker_layer_img", src = ":worker_layer")

#region shared
image_manifest(
    name = "image_api",
    base = image("python_base_img"),
    entrypoint = ["python", "/opt/app/main.py"],
    layers = [":common_layer_img", ":api_layer_img"],  # shared ↓
    platform = LINUX,
)

image_manifest(
    name = "image_worker",
    base = image("python_base_img"),
    entrypoint = ["python", "/opt/app/main.py"],
    layers = [":common_layer_img", ":worker_layer_img"],  # → same blob
    platform = LINUX,
)
#endregion

build_test(
    name = "images_build_test",
    targets = [
        ":image_api",
        ":image_worker",
    ],
)

# bazel run //samples/shared_layers:digests → prints the shared layer digests.
# The images are data, so `bazel run` builds them; the diff runs on the pinned
# interpreter, not the host's python3.
py_binary(
    name = "digests",
    srcs = ["digests.py"],
    args = [
        "$(rootpaths :image_api)",
        "$(rootpaths :image_worker)",
    ],
    data = [
        ":image_api",
        ":image_worker",
    ],
    main = "digests.py",
)
