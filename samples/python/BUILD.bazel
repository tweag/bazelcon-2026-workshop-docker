load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@container_structure_test//:defs.bzl", "container_structure_test")
load("@pypi//:requirements.bzl", "requirement")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("@rules_python//python:pip.bzl", "compile_pip_requirements")

package(default_visibility = ["//visibility:public"])

exports_files([
    "app.py",
    "requirements_lock.txt",
    "Dockerfile",
])

# `bazel run //samples/python:requirements.update` re-locks requirements.in.
compile_pip_requirements(
    name = "requirements",
    src = "requirements.in",
    requirements_txt = "requirements_lock.txt",
)

# --- The app being containerized ---------------------------------------------
py_binary(
    name = "app",
    srcs = ["app.py"],
    imports = ["."],  # put this package dir on sys.path -> `import app`
    main = "app.py",
    deps = [requirement("graphviz")],
)

# TASK §2.7 — unit test the payload independently of any image.
py_test(
    name = "app_test",
    size = "small",
    srcs = ["app_test.py"],
    imports = ["."],
    deps = [":app"],
)

# --- Layers (TASK §2.9: granular, cacheable) ---------------------------------
# The py_binary runfiles (hermetic interpreter + graphviz deps + app source)
# become one declarative, content-addressed layer. Changing app.py only
# rebuilds this layer; the base image layers are reused untouched.
pkg_tar(
    name = "app_layer",
    srcs = [":app"],
    include_runfiles = True,
    package_dir = "/app",
)

# --- The OCI image (the "after": no Docker daemon) ---------------------------
#region oci
oci_image(
    name = "image",
    base = "@python_base",
    entrypoint = [
        "/app/app",  # py_binary bootstrap launcher; locates /app/app.runfiles
        "--render",
        "/tmp/supply_chain.png",
    ],
    tars = [":app_layer"],
)
#endregion

# Load into the local Docker daemon for the live demo / smoke test:
#   bazel run //samples/python:image_load && docker run --rm bwb/python-graphviz
oci_load(
    name = "image_load",
    image = ":image",
    repo_tags = ["bwb/python-graphviz:latest"],
)

# TASK §2: prove the image assembles end to end (analysis + layer build).
build_test(
    name = "image_build_test",
    targets = [":image"],
)

# TASK §2.5 / Q3 — validate the image WITHOUT a daemon: the `tar` driver reads
# the layers + config in the Bazel sandbox (no container runtime). It needs a
# .tar, so pull the tarball output group out of oci_load.
filegroup(
    name = "image.tar",
    srcs = [":image_load"],
    output_group = "tarball",
)

container_structure_test(
    name = "image_structure_test",
    size = "small",
    configs = ["image_test.yaml"],
    driver = "tar",
    image = ":image.tar",
)
