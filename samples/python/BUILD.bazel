load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@container_structure_test//:defs.bzl", "container_structure_test")
load("@pypi//:requirements.bzl", "requirement")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_tar")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img//img:push.bzl", "image_push")
load("@rules_img_images.bzl", "image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("@rules_python//python:pip.bzl", "compile_pip_requirements")
load("//tools/platforms:defs.bzl", "LINUX")

package(default_visibility = ["//visibility:public"])

exports_files([
    "app.py",
    "requirements_lock.txt",
    "Dockerfile",
])

# Copy the files the deck transcludes (`<<< ../samples/python/...`) into bazel-bin
# so the hermetic //slides:build can read them at ../samples/python/... (rules_js
# runs from bazel-bin; copy_to_bin must be owned by this package).
copy_to_bin(
    name = "slides_inputs",
    srcs = [
        "BUILD.bazel",
        "Dockerfile",
        "app.py",
        "image_test.yaml",
    ],
)

# `bazel run //samples/python:requirements.update` re-locks requirements.in.
compile_pip_requirements(
    name = "requirements",
    src = "requirements.in",
    requirements_txt = "requirements_lock.txt",
)

# --- The app, and its runfiles as one layer (granular, cacheable) ---------
# The py_binary runfiles (hermetic interpreter + graphviz wheel + app.py) become
# one declarative, content-addressed layer, so changing app.py rebuilds only this
# layer and the base image layers are reused untouched.
# The deck transcludes the region below: slides/slides.md
# `<<< ../samples/python/BUILD.bazel#pip_layer` — keep it tight, it shares a
# half-slide column with MODULE.bazel's #pip_hub.
#region pip_layer
py_binary(
    name = "app",
    srcs = ["app.py"],
    imports = ["."],  # so `import app` resolves
    main = "app.py",
    deps = [requirement("graphviz")],  # from the @pypi hub
)

pkg_tar(
    name = "app_layer",
    srcs = [":app"],
    include_runfiles = True,
    package_dir = "/app",
)
#endregion

# Unit test the payload independently of any image.
py_test(
    name = "app_test",
    size = "small",
    srcs = ["app_test.py"],
    imports = ["."],
    deps = [":app"],
)

# --- The image via rules_img (tar-less, daemonless) --------------------------
#region image
layer_from_tar(
    name = "app_layer_img",
    src = ":app_layer",
    optimize = True,  # dedupe + zstd (see .bazelrc)
)

image_manifest(
    name = "image",
    base = image("python_base_img"),
    entrypoint = [
        "/app/app",  # the py_binary launcher
        "--render",
        "/tmp/supply_chain.png",
    ],
    layers = [":app_layer_img"],
    platform = LINUX,  # a Linux image, even on a Mac
)
#endregion

# Load into the local Docker daemon for the live demo / smoke test:
#   bazel run //samples/python:image_load && docker run --rm bwb/python-graphviz
image_load(
    name = "image_load",
    image = ":image",
    tag = "bwb/python-graphviz:latest",
)

# --- Push: one rule, built up step by step (deck: Module 3, then Module 4) ---
# The deck transcludes #push_local, #push_ttl and #push_lazy below
# (`<<< ../samples/python/BUILD.bazel#…`) — keep each region tight.
#
# Step 1 — the minimum: a local registry. Start one first:
#   bazel run //tools:local_registry     # registry:2 (or crane) on localhost:5000
#   bazel run //samples/python:push
# No `strategy` set, so it takes rules_img's default: eager (see step 3).
#region push_local
image_push(
    name = "push",
    image = ":image",
    registry = "localhost:5000",
    repository = "bwb/python-graphviz",
    tag = "latest",
)
#endregion

# Step 2 — the same rule, a shared registry. ttl.sh is anonymous and write-open,
# so there's no local registry, no daemon, no credentials; the image expires
# after the tag's TTL. {{.STABLE_BWB_ID}} is a stamp value from
# tools/workspace_status.sh (a hash of user@host), so each attendee gets their
# own repo and nobody overwrites anybody else's tag.
# Step 3 — EAGER, spelled out: every layer blob is symlinked into this target's
# runfiles (~78 MB here), so `bazel run` uploads from local disk. Run it twice:
# the second push only sends what the registry lacks.
#   bazel run //samples/python:push_eager
#region push_ttl
image_push(
    name = "push_eager",
    image = ":image",
    strategy = "eager",  # the default, spelled out
    registry = "ttl.sh",
    repository = "bwb-{{.STABLE_BWB_ID}}/graphviz",
    tag = "1h",  # ttl.sh: the tag IS the lifetime
    stamp = "force",  # expand {{…}} from workspace status
)
#endregion

# Step 4 — LAZY (needs a remote CACHE, not remote execution). The runfiles hold
# only metadata (~59 KB here); the push tool streams every blob straight from
# the cache over REAPI ByteStream, so nothing has to be on local disk:
#   bazel run //tools:local_cache
#   bazel run --config=local-bwb \
#       --@rules_img//img/settings:remote_cache=grpc://localhost:9092 \
#       //samples/python:push_lazy
#region push_lazy
image_push(
    name = "push_lazy",
    image = ":image",
    strategy = "lazy",  # was "eager"
    registry = "ttl.sh",
    repository = "bwb-{{.STABLE_BWB_ID}}/graphviz",
    tag = "1h",
    stamp = "force",
)
#endregion

# Prove the image assembles end to end (analysis + layer build).
build_test(
    name = "image_build_test",
    targets = [":image"],
)

# Validate the image WITHOUT a daemon: the `tar` driver reads
# the layers + config in the Bazel sandbox (no container runtime). image_load
# exposes a "tarball" output group (docker-save + OCI-layout compatible).
filegroup(
    name = "image.tar",
    srcs = [":image_load"],
    output_group = "tarball",
)

container_structure_test(
    name = "image_structure_test",
    size = "medium",  # unpacks the whole image per check; "small" (60 s) timed out on a cold, loaded setup
    configs = ["image_test.yaml"],
    driver = "tar",
    image = ":image.tar",
)

# --- A real OCI layout, for tools that live outside Bazel --------------------
# `image_manifest`'s DEFAULT on-disk shape is a *sparse* OCI layout: a
# `sparse-oci-layout` marker instead of `oci-layout`, `root.descriptor.json`
# instead of `index.json`, and most layers present only as `<digest>.descriptor.json`
# stubs. That is what keeps the bytes out of the graph — and it is also why
# `skopeo inspect oci:…` and `dive` bounce off it. These two output groups hand
# you a spec-compliant layout instead.
#
# Caveat worth knowing (the deck's appendix says it out loud): every blob in the
# `oci_layout` tree is a SYMLINK into the execroot, so `du -sh` reads ~12K while
# the real content is ~78M. Copy it with `cp -rL`, or use the `.tar` below,
# which packs real bytes and no symlinks.
# The deck transcludes the region below: slides/slides.md
# `<<< ../samples/python/BUILD.bazel#oci_layout`.
#region oci_layout
filegroup(
    name = "image.oci",  # a spec-compliant OCI layout directory
    srcs = [":image"],
    output_group = "oci_layout",
)

filegroup(
    name = "image.oci.tar",  # the same layout, packed — no symlinks
    srcs = [":image"],
    output_group = "oci_tarball",
)
#endregion
