load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_tar")
load("@rules_img//img:load.bzl", "image_load")

# Close the `dot` system-dep gap *hermetically* (workshop Module 3).
# Instead of `RUN apt-get install graphviz`, rules_distroless materializes `dot`
# + its 162 transitive .debs (pinned in graphviz.lock.json) into
# `@graphviz_apt//:flat`. We build the rootfs FROM SCRATCH (no base) via
# rules_img's `image_manifest` with an explicit target `platform`.
package(default_visibility = ["//visibility:public"])

exports_files([
    "graphviz.yaml",
    "graphviz.lock.json",
])

# The deck transcludes `<<< ../samples/distroless/BUILD.bazel#distroless`; copy it
# into bazel-bin for the hermetic //slides:build (rules_js runs from bazel-bin).
copy_to_bin(
    name = "slides_inputs",
    srcs = ["BUILD.bazel"],
)

# Scratch image needs an explicit platform (no base to infer os/arch from).
platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

#region apt_layer
layer_from_tar(
    name = "flat_layer",
    src = "@graphviz_apt//:flat",  # `dot` + deps, pinned
)
#endregion

#region distroless
image_manifest(
    name = "image",
    cmd = ["-V"],
    entrypoint = ["/usr/bin/dot"],
    layers = [":flat_layer"],
    platform = ":linux_amd64",  # scratch (no base)
)
#endregion

# bazel run //samples/distroless:image_load && docker run --rm bwb/distroless
#   -> "dot - graphviz version 2.43.0" from a fully hermetic, pinned toolchain.
#
# NOTE: `dot` runs, but rendering (`-Tpng`/`-Tsvg`) needs the plugin registry
# (/usr/lib/.../graphviz/config6) that Debian's postinst normally writes via
# `dot -c`. Generating that config at build time is the documented follow-up.
image_load(
    name = "image_load",
    image = ":image",
    tag = "bwb/distroless:latest",
)

build_test(
    name = "image_build_test",
    targets = [":image"],
)
