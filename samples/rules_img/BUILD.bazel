load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_tar")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img_images.bzl", "image")  # hub helper: image("<pull name>") -> label

# The same image via rules_img (TASK §2.4). Identical app layer as
# //samples/rules_oci — only the ruleset differs. rules_img uses
# image_manifest / layer_from_tar / image_load instead of rules_oci's
# oci_image / oci_load, and ships a faster content-addressed builder/pusher.
package(default_visibility = ["//visibility:public"])

#region img
# Reuse the exact same pkg_tar the rules_oci path uses.
layer_from_tar(
    name = "app_layer",
    src = "//samples/python:app_layer",
)

image_manifest(
    name = "image",
    base = image("python_base_img"),
    entrypoint = ["/app/app"],
    layers = [":app_layer"],
)
#endregion

# bazel run //samples/rules_img:load && docker run --rm bwb/rules-img
image_load(
    name = "load",
    image = ":image",
    tag = "bwb/rules-img:latest",
)

build_test(
    name = "image_build_test",
    targets = [":image"],
)
