{
  "name": "building-without-bytes-slides",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "slidev --open",
    "build": "slidev build",
    "build:pages": "slidev build --base /bazelcon-2026-workshop-docker/ --out dist",
    "export": "slidev export --per-slide --output ../docs/building-without-bytes.pdf"
  },
  "dependencies": {
    "@slidev/cli": "^52.20.1",
    "@slidev/theme-default": "^0.25.0",
    "playwright-chromium": "^1.63.0",
    "slidev-addon-rabbit": "^0.4.0"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.28",
    "@iconify-json/ph": "^1.2.2",
    "markdown-it": "^14.3.3"
  },
  "overrides": {
    "@unocss/vite": {
      "magic-string": "1.4.2"
    }
  },
  "pnpm": {
    "//": "rules_js reads this beside its lockfile; pnpm-workspace.yaml keeps the same empty allowlist for pnpm.",
    "onlyBuiltDependencies": []
  }
}
