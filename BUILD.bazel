# Root package. Most build logic lives under //samples, //slides, //benchmark,
# and //tools. This file anchors the workspace and hosts repo-wide aliases.

load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")

package(default_visibility = ["//visibility:public"])

# The deck transcludes MODULE.bazel's #base_pull and #apt_ext regions
# (`<<< ../MODULE.bazel#…`), so it has to be a readable source and a build input.
exports_files(["MODULE.bazel"])

# Stage it into bazel-bin so the hermetic //slides:build (which runs from
# bazel-bin/slides) resolves `../MODULE.bazel`. Mirrors //samples/*:slides_inputs;
# copy_to_bin must be owned by the package that owns the file.
copy_to_bin(
    name = "slides_inputs",
    srcs = ["MODULE.bazel"],
)

# Convenience alias: `bazel build //:slides` renders the deck.
alias(
    name = "slides",
    actual = "//slides:build",
)

# Convenience alias: `bazel run //:graph -- //...` renders the dependency graph.
alias(
    name = "graph",
    actual = "//tools:render_graph",
)
