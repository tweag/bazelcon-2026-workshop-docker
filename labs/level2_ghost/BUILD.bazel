# Level 2 — The "Ghost" Runtime Trap (pytesseract).   [SKELETON — fill the TODOs]
#
# The descent (run each; green = rung cleared):
#   surface : bazel test //labs/level2_ghost:app_test               (green already —
#             read it: it proves in pure Python that the engine is missing)
#   deep    : bazel test //labs/level2_ghost:image_structure_test   (RED now — 3
#             checks: the binary, its language data, and TESSDATA_PREFIX)
#   abyss   : see HINT.md  (make OCR actually run, hermetically)
#
# The structure test only prints `level=fatal msg=FAIL` when it fails.
# Decode it with:  bazel run //labs:explain -- level2
#
# The Python wrapper is already wired; the lesson is the apt LAYER, not the pip
# dep. Stuck? read HINT.md, or peek at //labs/level2_ghost/solution.
load("@container_structure_test//:defs.bzl", "container_structure_test")
load("@labs_pypi//:requirements.bzl", "requirement")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_tar")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img_images.bzl", "image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "sample.png",
    "tesseract.yaml",
    "tesseract.lock.json",
    "image_test.yaml",
    "app.py",
    "app_test.py",
])

py_binary(
    name = "app",
    srcs = ["app.py"],
    imports = ["."],
    main = "app.py",
    deps = [
        requirement("pytesseract"),
        requirement("pillow"),
    ],
)

# Pure-Python proof that the engine is a ghost (green: no binary in the sandbox).
py_test(
    name = "app_test",
    size = "small",
    srcs = ["app_test.py"],
    imports = ["."],
    tags = ["manual", "surface"],
    deps = [":app"],
)

# TODO(abyss): `sample.png` is sitting right here but never reaches the image.
# Add it to `srcs` (it lands at /app/sample.png), then:
#   bazel run //labs/level2_ghost:image_load
#   docker run --rm bwb/level2-ghost --ocr /app/sample.png
pkg_tar(
    name = "app_layer",
    srcs = [":app"],
    include_runfiles = True,
    package_dir = "/app",
)

layer_from_tar(
    name = "app_layer_img",
    src = ":app_layer",
)

# TODO(surface): the `tesseract` binary is a ghost. Wrap the hermetic apt tar as
# a layer and add it below:
#   layer_from_tar(name = "tesseract_layer_img", src = "@tesseract_apt//:flat")
image_manifest(
    name = "image",
    base = image("python_base_img"),
    entrypoint = ["/app/app"],
    # TODO(deep): tesseract can't locate its language data without a pointer:
    #   env = {"TESSDATA_PREFIX": "/usr/share/tesseract-ocr/5/tessdata/"},
    # TODO(surface): add ":tesseract_layer_img" to layers so the engine + data
    #   land in the image.
    layers = [":app_layer_img"],
)

image_load(
    name = "image_load",
    image = ":image",
    tag = "bwb/level2-ghost:latest",
)

filegroup(
    name = "image.tar",
    srcs = [":image_load"],
    output_group = "tarball",
)

# SURFACE + DEEP — daemonless (tar driver). RED until the layer + env are added.
container_structure_test(
    name = "image_structure_test",
    size = "small",
    configs = ["image_test.yaml"],
    driver = "tar",
    image = ":image.tar",
    tags = ["manual", "surface"],
)
