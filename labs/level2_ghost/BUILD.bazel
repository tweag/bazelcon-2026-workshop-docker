# Level 2 — The "Ghost" Runtime Trap (pytesseract). Fill the TODOs.
# Goal, commands and tasks: README.md. Answer: ./solution.
load("@container_structure_test//:defs.bzl", "container_structure_test")
load("@labs_pypi//:requirements.bzl", "requirement")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_tar")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img_images.bzl", "image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "sample.png",
    "tesseract.yaml",
    "tesseract.lock.json",
    "image_test.yaml",
    "app.py",
    "app_test.py",
])

py_binary(
    name = "app",
    srcs = ["app.py"],
    imports = ["."],
    main = "app.py",
    deps = [
        requirement("pytesseract"),
        requirement("pillow"),
    ],
)

# Task 0 (green) — proves in pure Python that the engine binary is missing.
py_test(
    name = "app_test",
    size = "small",
    srcs = ["app_test.py"],
    imports = ["."],
    tags = ["manual"],
    deps = [":app"],
)

# TODO(stretch): add "sample.png" to srcs, then OCR it with docker run.
pkg_tar(
    name = "app_layer",
    srcs = [":app"],
    include_runfiles = True,
    package_dir = "/app",
)

layer_from_tar(
    name = "app_layer_img",
    src = ":app_layer",
    optimize = True,  # dedupe + recompress (zstd: .bazelrc)
)

# TODO(task 1): wrap "@tesseract_apt//:flat" in a layer_from_tar.
image_manifest(
    name = "image",
    base = image("python_base_img"),
    entrypoint = ["/app/app"],
    # TODO(task 2): set env TESSDATA_PREFIX so tesseract finds its data.
    # TODO(task 1): add the tesseract layer to layers.
    layers = [":app_layer_img"],
)

image_load(
    name = "image_load",
    image = ":image",
    tag = "bwb/level2-ghost:latest",
)

filegroup(
    name = "image.tar",
    srcs = [":image_load"],
    output_group = "tarball",
)

# Tasks 1–2 — daemonless (tar driver). Red until the layer + env are added.
container_structure_test(
    name = "image_structure_test",
    size = "medium",
    configs = ["image_test.yaml"],
    driver = "tar",
    image = ":image.tar",
    tags = ["manual"],
)
