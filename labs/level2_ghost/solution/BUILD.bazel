# Level 2 — reference solution (green). The fills vs. the skeleton: the apt
# layer (the real engine + data) and the TESSDATA_PREFIX pointer. No RUN, no
# daemon, no network — the layer is pinned in tesseract.lock.json. The ★
# stretches are left as in the skeleton.
load("@container_structure_test//:defs.bzl", "container_structure_test")
load("@labs_pypi//:requirements.bzl", "requirement")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_tar")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img_images.bzl", "image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//tools/platforms:defs.bzl", "LINUX")

py_binary(
    name = "app",
    srcs = ["app.py"],
    imports = ["."],
    main = "app.py",
    deps = [
        requirement("pytesseract"),
        requirement("pillow"),
    ],
)

# Task 0 (green) — proves in pure Python that the engine binary is missing.
py_test(
    name = "app_test",
    size = "small",
    srcs = ["app_test.py"],
    imports = ["."],
    deps = [":app"],
)

# TODO(stretch): add "sample.png" to srcs, then OCR it with docker run.
pkg_tar(
    name = "app_layer",
    srcs = [":app"],
    include_runfiles = True,
    package_dir = "/app",
)

layer_from_tar(
    name = "app_layer_img",
    src = ":app_layer",
    optimize = True,  # dedupe + zstd (see .bazelrc)
)

# Task 1: the hermetic engine + eng data, as a layer.
layer_from_tar(
    name = "tesseract_layer_img",
    src = "@tesseract_apt//:flat",
)

image_manifest(
    name = "image",
    base = image("python_base_img"),
    entrypoint = ["/app/app"],
    env = {"TESSDATA_PREFIX": "/usr/share/tesseract-ocr/5/tessdata/"},  # task 2
    layers = [
        ":app_layer_img",
        ":tesseract_layer_img",  # task 1
    ],
    platform = LINUX,  # a Linux image, even on a Mac
)

image_load(
    name = "image_load",
    image = ":image",
    tag = "bwb/level2-ghost:latest",
)

filegroup(
    name = "image.tar",
    srcs = [":image_load"],
    output_group = "tarball",
)

# Tasks 1–2 — daemonless (tar driver). Red until the layer + env are added.
container_structure_test(
    name = "image_structure_test",
    size = "medium",
    configs = ["//labs/level2_ghost:image_test.yaml"],
    driver = "tar",
    image = ":image.tar",
)
