# Level 3 — The Hardware Wall (pyopencl + POCL). Fill the TODOs.
# Goal, commands and tasks: README.md. Answer: ./solution.
load("@container_structure_test//:defs.bzl", "container_structure_test")
load("@labs_pypi//:requirements.bzl", "requirement")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_tar")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img_images.bzl", "image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//tools/platforms:defs.bzl", "LINUX")

package(default_visibility = ["//visibility:public"])

exports_files([
    "pocl.yaml",
    "pocl.lock.json",
    "image_test.yaml",
    "image_test_x86_64.yaml",
    "image_test_aarch64.yaml",
])

py_binary(
    name = "app",
    srcs = ["app.py"],
    imports = ["."],
    main = "app.py",
    deps = [
        requirement("pyopencl"),
        requirement("numpy"),
    ],
)

# Task 0 (green) — bindings + device probe; whether a device exists is up to
# the environment.
py_test(
    name = "app_test",
    size = "small",
    srcs = ["app_test.py"],
    imports = ["."],
    tags = ["manual"],
    deps = [":app"],
)

pkg_tar(
    name = "app_layer",
    srcs = [":app"],
    include_runfiles = True,
    package_dir = "/app",
)

layer_from_tar(
    name = "app_layer_img",
    src = ":app_layer",
    optimize = True,  # dedupe + zstd (see .bazelrc)
)

# TODO(task 1): wrap "@pocl_apt//:flat" (CPU OpenCL) in a layer_from_tar.
image_manifest(
    name = "image",
    base = image("python_base_img"),
    entrypoint = ["/app/app"],
    # TODO(task 1): add the POCL layer to layers.
    layers = [":app_layer_img"],
    platform = LINUX,  # a Linux image, even on a Mac
)

image_load(
    name = "image_load",
    image = ":image",
    tag = "bwb/level3-hardware:latest",
)

filegroup(
    name = "image.tar",
    srcs = [":image_load"],
    output_group = "tarball",
)

# Task 1 — daemonless. Red until the POCL layer is bundled.
container_structure_test(
    name = "image_structure_test",
    size = "medium",
    configs = ["image_test.yaml"] + select({
        "@platforms//cpu:aarch64": ["image_test_aarch64.yaml"],
        "//conditions:default": ["image_test_x86_64.yaml"],
    }),
    driver = "tar",
    image = ":image.tar",
    tags = ["manual"],
)
