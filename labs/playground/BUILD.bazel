# Playground — a green, working image to change. Tasks to try: README.md.
load("@container_structure_test//:defs.bzl", "container_structure_test")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_tar")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img_images.bzl", "image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")

package(default_visibility = ["//visibility:public"])

# `deps` is deliberately empty (README task 3).
py_binary(
    name = "app",
    srcs = ["app.py"],
    imports = ["."],
    main = "app.py",
    deps = [],
)

py_test(
    name = "app_test",
    size = "small",
    srcs = ["app_test.py"],
    imports = ["."],
    deps = [":app"],
)

# Layer 1 — the app: interpreter + code + deps.
pkg_tar(
    name = "app_layer",
    srcs = [":app"],
    include_runfiles = True,
    package_dir = "/app",
)

# Layer 2 — config, split out so editing it doesn't rebuild the app layer.
pkg_tar(
    name = "config_layer",
    srcs = ["greeting.txt"],
    package_dir = "/etc/playground",
)

layer_from_tar(
    name = "app_layer_img",
    src = ":app_layer",
    optimize = True,  # dedupe + recompress (zstd: .bazelrc)
)

layer_from_tar(
    name = "config_layer_img",
    src = ":config_layer",
)

image_manifest(
    name = "image",
    base = image("python_base_img"),
    entrypoint = ["/app/app"],
    env = {"PLAYGROUND_CONFIG": "/etc/playground/greeting.txt"},
    layers = [
        ":app_layer_img",
        ":config_layer_img",
    ],
)

image_load(
    name = "image_load",
    image = ":image",
    tag = "bwb/playground:latest",
)

filegroup(
    name = "image.tar",
    srcs = [":image_load"],
    output_group = "tarball",
)

# Daemonless validation. Add your own assertions to image_test.yaml.
container_structure_test(
    name = "image_structure_test",
    size = "medium",
    configs = ["image_test.yaml"],
    driver = "tar",
    image = ":image.tar",
)
