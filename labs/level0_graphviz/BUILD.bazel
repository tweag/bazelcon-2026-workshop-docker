# Level 0 — Dockerfile -> rules_img (graphviz). Fill the TODOs.
# Goal, commands and tasks: README.md. Answer: ./solution.
load("@container_structure_test//:defs.bzl", "container_structure_test")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_tar")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img_images.bzl", "image")  # buildifier: disable=load

package(default_visibility = ["//visibility:public"])

exports_files([
    "graphviz.yaml",
    "graphviz.lock.json",
    "image_test.yaml",
])

# Done for you: the deck's payload (py_binary + pip wheel + app.py), unchanged.
layer_from_tar(
    name = "app_layer_img",
    src = "//samples/python:app_layer",
    optimize = True,  # dedupe + recompress (zstd: .bazelrc)
)

# TODO(task 2): wrap "@graphviz_lab_apt//:flat" in a layer_from_tar.
image_manifest(
    name = "image",
    # TODO(task 1): translate FROM and ENTRYPOINT from samples/python/Dockerfile.
    # TODO(task 2): add the dot layer to layers.
    layers = [":app_layer_img"],
)

image_load(
    name = "image_load",
    image = ":image",
    tag = "bwb/level0-graphviz:latest",
)

filegroup(
    name = "image.tar",
    srcs = [":image_load"],
    output_group = "tarball",
)

# Tasks 1–2 — daemonless (tar driver). Red until base, entrypoint and dot are in.
container_structure_test(
    name = "image_structure_test",
    size = "medium",
    configs = ["image_test.yaml"],
    driver = "tar",
    image = ":image.tar",
    tags = ["manual"],
)
