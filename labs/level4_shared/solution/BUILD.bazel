# Level 4 — reference solution (green). The change from the skeleton: each
# service's layer comes from layer_from_binary over its py_layered_binary, so
# the interpreter and the wheel become layers of their own, shared by both images.
load("@labs_pypi//:requirements.bzl", "requirement")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_binary")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img_images.bzl", "image")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("@rules_runfiles_group//runfiles_group:runfiles_group_analysis_test.bzl", "runfiles_group_analysis_test")
load("//labs/level4_shared:defs.bzl", "py_layered_binary")
load("//tools/platforms:defs.bzl", "LINUX")

# Two services that ship together: the api signs job tickets, the worker checks
# them. Same interpreter, same cryptography wheel, different .py file.
py_binary(
    name = "api",
    srcs = ["api.py"],
    legacy_create_init = 0,  # see defs.bzl
    main = "api.py",
    deps = [requirement("cryptography")],
)

py_binary(
    name = "worker",
    srcs = ["worker.py"],
    legacy_create_init = 0,
    main = "worker.py",
    deps = [requirement("cryptography")],
)

# The same binaries, with their runfiles sorted into interpreter / third_party /
# app groups. Read defs.bzl: it's the whole trick.
py_layered_binary(
    name = "api_layered",
    binary = ":api",
)

py_layered_binary(
    name = "worker_layered",
    binary = ":worker",
)

# Task 0 — green: the three groups add up to exactly the binary's runfiles.
runfiles_group_analysis_test(
    name = "groups_test",
    binaries = [
        ":api_layered",
        ":worker_layered",
    ],
)

# Task 1: one layer per runfiles group, so the interpreter and wheel layers are
# byte-identical across both services.
layer_from_binary(
    name = "api_layers",
    binary = ":api_layered",
    path = "/app/api",
)

layer_from_binary(
    name = "worker_layers",
    binary = ":worker_layered",
    path = "/app/worker",
)

image_manifest(
    name = "image_api",
    base = image("python_base_img"),
    entrypoint = ["/app/api"],
    layers = [":api_layers"],  # task 1
    platform = LINUX,  # a Linux image, even on a Mac
)

image_manifest(
    name = "image_worker",
    base = image("python_base_img"),
    entrypoint = ["/app/worker"],
    layers = [":worker_layers"],  # task 1
    platform = LINUX,  # a Linux image, even on a Mac
)

# Task 1 — reads both manifests: the worker may add only its app code.
filegroup(
    name = "api_manifest",
    srcs = [":image_api"],
    output_group = "root_blob",
)

filegroup(
    name = "worker_manifest",
    srcs = [":image_worker"],
    output_group = "root_blob",
)

py_test(
    name = "shared_layers_test",
    size = "small",
    srcs = ["//labs/level4_shared:shared_test.py"],
    args = [
        "$(rootpath :api_manifest)",
        "$(rootpath :worker_manifest)",
    ],
    data = [
        ":api_manifest",
        ":worker_manifest",
    ],
    main = "shared_test.py",
)

# ★ bazel run //labs/level4_shared:api_load && docker run --rm bwb/level4-api
image_load(
    name = "api_load",
    image = ":image_api",
    tag = "bwb/level4-api:latest",
)

image_load(
    name = "worker_load",
    image = ":image_worker",
    tag = "bwb/level4-worker:latest",
)
