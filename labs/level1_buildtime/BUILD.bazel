# Level 1 — The Build-Time Trap (cryptography). Fill the TODO.
# Goal, commands and tasks: README.md. Answer: ./solution.
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@labs_pypi//:requirements.bzl", "requirement")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_tar")
load("@rules_img_images.bzl", "image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "app.py",
    "app_test.py",
    "layer_test.py",
])

py_binary(
    name = "app",
    srcs = ["app.py"],
    imports = ["."],
    main = "app.py",
    # TODO(task 1): add the cryptography wheel. Hint: requirement("...").
    deps = [],
)

# Task 1 — green once :app can import cryptography.
py_test(
    name = "app_test",
    size = "small",
    srcs = ["app_test.py"],
    imports = ["."],
    tags = ["manual"],
    deps = [":app"],
)

pkg_tar(
    name = "app_layer",
    srcs = [":app"],
    include_runfiles = True,
    package_dir = "/app",
)

layer_from_tar(
    name = "app_layer_img",
    src = ":app_layer",
    optimize = True,  # dedupe + recompress (zstd: .bazelrc)
)

image_manifest(
    name = "image",
    base = image("python_base_img"),
    entrypoint = ["/app/app"],
    layers = [":app_layer_img"],
    tags = ["manual"],
)

# Task 2 — opens the layer: the prebuilt wheel is inside, no sdist leftovers.
py_test(
    name = "image_layer_test",
    size = "small",
    srcs = ["layer_test.py"],
    args = ["$(rootpath :app_layer)"],
    data = [":app_layer"],
    main = "layer_test.py",
    tags = ["manual"],
)

# Green even with deps = []: a build_test can't see what's inside an image.
build_test(
    name = "image_build_test",
    tags = ["manual"],
    targets = [":image"],
)
