# Level 1 — reference solution (green). The only change from the skeleton is
# wiring the prebuilt cryptography wheel as a dep; no compiler ever runs.
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@labs_pypi//:requirements.bzl", "requirement")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_tar")
load("@rules_img_images.bzl", "image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//tools/platforms:defs.bzl", "LINUX")

py_binary(
    name = "app",
    srcs = ["app.py"],
    imports = ["."],
    main = "app.py",
    deps = [requirement("cryptography")],  # task 1: the prebuilt wheel
)

# Task 1 — green once :app can import cryptography.
py_test(
    name = "app_test",
    size = "small",
    srcs = ["app_test.py"],
    imports = ["."],
    deps = [":app"],
)

pkg_tar(
    name = "app_layer",
    srcs = [":app"],
    include_runfiles = True,
    package_dir = "/app",
)

layer_from_tar(
    name = "app_layer_img",
    src = ":app_layer",
    optimize = True,  # dedupe + zstd (see .bazelrc)
)

image_manifest(
    name = "image",
    base = image("python_base_img"),
    entrypoint = ["/app/app"],
    layers = [":app_layer_img"],
    platform = LINUX,  # a Linux image, even on a Mac
)

# Task 2 — opens the layer: the prebuilt wheel is inside, no sdist leftovers.
py_test(
    name = "image_layer_test",
    size = "small",
    srcs = ["//labs/level1_buildtime:layer_test.py"],
    args = ["$(rootpath :app_layer)"],
    data = [":app_layer"],
    main = "layer_test.py",
)

# Green even with deps = []: a build_test can't see what's inside an image.
build_test(
    name = "image_build_test",
    targets = [":image"],
)
